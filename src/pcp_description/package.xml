<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pcp_description</name>
  <version>0.1.0</version>
  <description>UR5e (ur_simulation_gz) plus a fixed Gazebo rgbd_camera, as a xacro overlay.</description>
  <maintainer email="giridharjshenoy@gmail.com">Giridhar J Shenoy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
