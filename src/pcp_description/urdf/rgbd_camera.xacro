<?xml version="1.0"?>
<!-- Fixed RGB-D camera: a mount link on `parent` plus a Gazebo rgbd_camera sensor.
     The sensor publishes gz topics <topic>/image, /depth_image, /points and /camera_info. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="pcp_rgbd_camera" params="parent xyz rpy topic:=camera width:=320 height:=240 hfov:=1.2217 rate:=2">
    <link name="camera_link">
      <visual>
        <geometry><box size="0.03 0.12 0.03"/></geometry>
        <material name="camera_grey"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <!-- No collision geometry, because the camera sits outside the workspace and must not
           appear in MoveIt's collision model. -->
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </link>
    <joint name="camera_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="camera_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <!-- REP-103 optical frame (z forward, x right, y down) for image consumers. -->
    <link name="camera_optical_frame"/>
    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <gazebo reference="camera_link">
      <sensor name="rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>${rate}</update_rate>
        <visualize>false</visualize>
        <topic>${topic}</topic>
        <!-- gz-sensors fills PointCloudPacked in the sensor (link) frame, x forward. -->
        <gz_frame_id>camera_link</gz_frame_id>
        <camera>
          <horizontal_fov>${hfov}</horizontal_fov>
          <image>
            <width>${width}</width>
            <height>${height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>3.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.1</near>
              <far>3.0</far>
            </clip>
          </depth_camera>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
