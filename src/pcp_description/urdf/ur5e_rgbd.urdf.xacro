<?xml version="1.0"?>
<!-- UR5e in Gazebo (ur_simulation_gz's description, unchanged) plus a fixed RGB-D camera that
     looks at the shelf from behind and above the robot. Pass the same xacro args as
     ur_simulation_gz/urdf/ur_gz.urdf.xacro (ur_type, simulation_controllers, ...). -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.urdf.xacro"/>
  <xacro:include filename="$(find pcp_description)/urdf/rgbd_camera.xacro"/>

  <!-- Camera at (-0.5, -0.6, 1.3) m looking at the shelf centre (0.6, 0, 0.45), so
       yaw = atan2(0.6, 1.1) and pitch = atan2(0.85, hypot(1.1, 0.6)). Everything it sees is
       within the 2.0 m max_range of the octomap updater. No colons in comments here because
       launch_ros parses the xacro output as YAML before treating it as a string. -->
  <xacro:pcp_rgbd_camera parent="world" xyz="-0.5 -0.6 1.3" rpy="0 0.5959 0.4993"/>
</robot>
