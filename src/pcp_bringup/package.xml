<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pcp_bringup</name>
  <version>0.1.0</version>
  <description>Launch files, Gazebo worlds and bridge config for pointcloud-constrained-planning.</description>
  <maintainer email="giridharjshenoy@gmail.com">Giridhar J Shenoy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>pcp_description</exec_depend>
  <exec_depend>pcp_moveit_config</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
